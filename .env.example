# Passwort der Datenbank (nur intern im Stack). Erzeugen: openssl rand -hex 24
POSTGRES_PASSWORD=

# Mailserver der Schule: Die Anmeldung prüft E-Mail und Passwort per IMAP (TLS, Port 993).
# Der Name muss im Zertifikat des Servers stehen, sonst lehnt die App die Verbindung ab
# (auch beim SMTP_HOST unten).
IMAP_HOST=mail.example.de

# Nur Postfächer dieser Domain(s) dürfen hinein, durch Komma getrennt. Bei genau einer Domain
# genügt beim Anmelden der Name vor dem @.
ANMELDE_DOMAINS=schule.example.de

# Freiwillig: Kurzdomains derselben Postfächer. Die App schreibt sie beim Anmelden auf die eine
# Domain aus ANMELDE_DOMAINS um, etwa name@kurz.example zu name@schule.example.de.
# ALIAS_DOMAINS=kurz.example

# Feste Verwaltung, durch Komma getrennt: kann sich nicht aussperren. Alle weiteren Rollen
# (Hausmeister, Leitung, Verwaltung) vergibt ein Admin in der App unter „Einstellungen“.
ADMINS=verwaltung@schule.example.de

SCHULNAME=Musterschule

# Mail an den Hausmeister. Ohne SMTP_HOST verschickt die App keine Mails.
SMTP_HOST=smtp.example.de
SMTP_PORT=587
SMTP_BENUTZER=
SMTP_PASSWORT=
MAIL_ABSENDER=schadenmeldung@schule.example.de
# Adresse der App, für die Knöpfe in der Mail
OEFFENTLICHE_ADRESSE=https://schaden.schule.example.de

# Freiwillig:
# ZEITZONE=Europe/Berlin
# IMAP_PORT=993
# Fotos so viele Tage nach der Erledigung löschen:
# FOTO_TAGE=30
# Meldungen so viele Tage nach der Erledigung löschen:
# AUFBEWAHRUNG_TAGE=365
